---
import { site } from "../data/site.js";
---

<footer class="site-footer">
  <div class="container">
    <p>{site.name} · {site.affiliation} · {site.location}</p>
    <p>
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> ·
      <a href={site.piHomepage}>{site.piName}</a> ·
      <a href={site.sourceRepo}>GitHub</a>
    </p>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.88rem;
    padding: 1.5rem 0 2rem;
  }

  p + p {
    margin-top: 0.2rem;
  }
</style>
