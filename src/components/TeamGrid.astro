---
import { getCollection } from "astro:content";
import { withBase } from "../data/site.js";
import { memberSlug } from "../lib/publications";

const allMembers = (await getCollection("team")).map((entry) => entry.data).sort((a, b) => a.order - b.order);
const teamMembers = allMembers.filter((member) => !member.alumni);
const alumni = allMembers.filter((member) => member.alumni);
const groups = [
  { role: "Postdoc", label: "Postdoctoral Researchers" },
  { role: "PhD Student", label: "PhD Students" },
  { role: "Master Student", label: "Master's Students" },
  { role: "Visiting Student", label: "Visiting Students" },
  { role: "Research Assistant", label: "Research Assistants" }
]
  .map((group) => ({ ...group, members: teamMembers.filter((member) => member.role === group.role) }))
  .filter((group) => group.members.length > 0);
const pis = teamMembers.filter((member) => member.role === "PI");
const initials = (name: string) => name.split(" ").map((part) => part[0]).join("");
const groupSlug = (role: string) => role.toLowerCase().replaceAll(" ", "-");
// Some entries repeat the role as their affiliation; only show it when it adds something.
const detail = (member: (typeof teamMembers)[number]) => (member.affiliation !== member.role ? member.affiliation : "");
---

{pis.map((member) => (
  <section class="pi" id={`member-${memberSlug(member.name)}`}>
    <div class="photo">
      {member.photo ? (
        <img src={withBase(member.photo)} alt={member.name} style={`object-position: ${member.photoPosition ?? "50% 35%"}`} />
      ) : (
        <span aria-hidden="true">{initials(member.name)}</span>
      )}
    </div>
    <div>
      <h2>{member.website ? <a href={member.website}>{member.name}</a> : member.name}</h2>
      <p class="detail">Principal Investigator · {member.affiliation}</p>
      {member.bio && <p class="bio">{member.bio}</p>}
      {member.website && <p class="bio"><a href={member.website}>Homepage</a></p>}
    </div>
  </section>
))}

{groups.map((group) => (
  <section class="section" id={groupSlug(group.role)}>
    <div class="section-head"><h2>{group.label}</h2></div>
    <ul class="member-grid">
      {group.members.map((member) => {
        const slug = memberSlug(member.name);
        // The photo toggles the bio; members without a bio get a plain photo.
        const Photo = member.bio ? "button" : "div";
        const toggle = member.bio
          ? ({ type: "button", "aria-expanded": "false", "aria-controls": `bio-${slug}`, "aria-label": `Show biography of ${member.name}` } as const)
          : {};

        return (
          <li id={`member-${slug}`}>
            <Photo class="photo" {...toggle}>
              {member.photo ? (
                <img
                  src={withBase(member.photo)}
                  alt={member.bio ? "" : member.name}
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${member.photoPosition ?? "50% 35%"}`}
                />
              ) : (
                <span aria-hidden="true">{initials(member.name)}</span>
              )}
            </Photo>
            <h3>{member.website ? <a href={member.website}>{member.name}</a> : member.name}</h3>
            {(detail(member) || member.period) && (
              <p class="detail">
                {detail(member)}
                {detail(member) && member.period && <br />}
                {member.period && <span class="period">{member.period}</span>}
              </p>
            )}
            {member.bio && <p class="bio" id={`bio-${slug}`} hidden>{member.bio}</p>}
          </li>
        );
      })}
    </ul>
  </section>
))}

{alumni.length > 0 && (
  <section class="section" id="alumni">
    <div class="section-head"><h2>Alumni</h2></div>
    <ul class="alumni">
      {alumni.map((member) => (
        <li id={`member-${memberSlug(member.name)}`}>
          {member.website ? <a class="alumni-name" href={member.website}>{member.name}</a> : <span class="alumni-name">{member.name}</span>}
          <span class="detail">
            {[member.role, member.period, detail(member)].filter(Boolean).join(" · ")}
          </span>
          {member.nowAt && (
            <span>Now at {member.nowAtUrl ? <a href={member.nowAtUrl}>{member.nowAt}</a> : member.nowAt}</span>
          )}
        </li>
      ))}
    </ul>
  </section>
)}

<noscript>
  <style is:inline>.member-grid .bio[hidden] { display: block; }</style>
</noscript>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>(".member-grid button.photo");

  const setOpen = (button: HTMLButtonElement, open: boolean) => {
    const bio = document.getElementById(button.getAttribute("aria-controls") ?? "");
    if (!bio) return;
    button.setAttribute("aria-expanded", String(open));
    bio.hidden = !open;
  };

  toggles.forEach((button) => {
    button.addEventListener("click", () => setOpen(button, button.getAttribute("aria-expanded") !== "true"));
  });

  // Author links on publication lists point at #member-<slug>; open that person's bio.
  const openFromHash = () => {
    const target = location.hash ? document.getElementById(location.hash.slice(1)) : null;
    const button = target?.querySelector<HTMLButtonElement>("button.photo");
    if (button) setOpen(button, true);
  };
  openFromHash();
  window.addEventListener("hashchange", openFromHash);
</script>

<style>
  .pi {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 9.5rem 1fr;
    margin-top: 2rem;
  }

  .photo {
    aspect-ratio: 1;
    background: var(--surface);
    border-radius: 4px;
    overflow: hidden;
  }

  .photo img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .photo span {
    align-items: center;
    color: var(--muted);
    display: flex;
    font-family: var(--font-serif);
    font-size: 2rem;
    height: 100%;
    justify-content: center;
  }

  h2 a,
  h3 a {
    color: var(--text);
  }

  h2 a:hover,
  h3 a:hover {
    color: var(--accent);
  }

  .detail {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .period {
    white-space: nowrap;
  }

  .bio {
    font-size: 0.94rem;
    margin-top: 0.4rem;
  }

  .pi .detail {
    margin-top: 0.15rem;
  }

  .pi .bio {
    font-size: 1rem;
    max-width: 60ch;
  }

  .member-grid {
    display: grid;
    gap: 1.75rem 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    list-style: none;
    padding: 0;
  }

  .member-grid .photo {
    margin-bottom: 0.6rem;
  }

  button.photo {
    border: 0;
    color: inherit;
    cursor: pointer;
    display: block;
    font: inherit;
    padding: 0;
    width: 100%;
  }

  button.photo:hover img {
    opacity: 0.9;
  }

  button.photo[aria-expanded="true"] {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .member-grid h3 {
    font-size: 1.05rem;
  }

  .member-grid .bio {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .alumni {
    list-style: none;
    padding: 0;
  }

  .alumni li {
    display: grid;
    gap: 0 1rem;
    grid-template-columns: 9rem 1fr;
    padding: 0.35rem 0;
  }

  .alumni .alumni-name {
    font-family: var(--font-serif);
    font-weight: 600;
    grid-row: span 2;
  }

  a.alumni-name {
    color: var(--text);
  }

  a.alumni-name:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .alumni li {
      grid-template-columns: 1fr;
    }

    .alumni .alumni-name {
      grid-row: auto;
    }

    .pi {
      grid-template-columns: 6.5rem 1fr;
      gap: 1rem;
    }

    .member-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 1rem;
    }
  }
</style>
