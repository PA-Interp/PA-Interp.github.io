---
import { newsItems } from "../data/news.js";
import { withBase } from "../data/site.js";

interface Props {
  limit?: number;
  /** Show the one-line description under each title. */
  details?: boolean;
}

const { limit, details = false } = Astro.props;
const items = limit ? newsItems.slice(0, limit) : newsItems;
const resolveHref = (href: string) => (href?.startsWith("/") ? withBase(href) : href);
const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const formatDate = (date: string) => {
  const [year, month] = date.split("-");
  return month ? `${months[Number(month) - 1]} ${year}` : year;
};
---

<ul class="news-list">
  {items.map((item) => (
    <li>
      <time datetime={item.date}>{formatDate(item.date)}</time>
      <div>
        {item.href ? <a href={resolveHref(item.href)}>{item.title}</a> : <span>{item.title}</span>}
        {details && item.text && <p>{item.text}</p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .news-list {
    list-style: none;
    padding: 0;
  }

  li {
    display: grid;
    gap: 1rem;
    grid-template-columns: 5.5rem 1fr;
    padding: 0.45rem 0;
  }

  time {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  p {
    color: var(--muted);
    font-size: 0.94rem;
    margin-top: 0.1rem;
  }
</style>
