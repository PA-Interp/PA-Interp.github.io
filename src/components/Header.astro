---
import { site, withBase } from "../data/site.js";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "");
const currentPath = basePath && Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length) || "/"
  : Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase("/")}>
      {site.name}<span class="brand-affiliation">MBZUAI</span>
    </a>
    <nav aria-label="Primary">
      {site.nav.map((item) => (
        <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding: 1.1rem 0 0.9rem;
  }

  .brand {
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
  }

  .brand:hover {
    color: var(--text);
    text-decoration: none;
  }

  .brand-affiliation {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    margin-left: 0.6rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  nav a {
    color: var(--text);
    font-size: 0.97rem;
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a[aria-current="page"] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  @media (max-width: 640px) {
    nav {
      column-gap: 0.85rem;
    }

    nav a {
      font-size: 0.92rem;
    }
  }
</style>
