---
import PublicationEntry from "./PublicationEntry.astro";
import { researchAreas } from "../data/researchAreas.js";
import type { Publication } from "../lib/publications";

interface Props {
  publications: Publication[];
}

const { publications } = Astro.props;
const years = [...new Set(publications.map((paper) => paper.year))].sort((a, b) => b - a);
const topics = researchAreas.map((area) => area.title);
const venues = [...new Set(publications.map((paper) => paper.venueShort).filter(Boolean))].sort();
const artifacts = [...new Set(publications.flatMap((paper) => paper.artifacts ?? []))].sort();
const capitalize = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
---

<section class="archive" data-publication-archive>
  <div class="controls" aria-label="Filter publications">
    <label class="search">
      Search
      <input data-filter="search" type="search" placeholder="Title, author, venue, or abstract" />
    </label>
    <label>
      Year
      <select data-filter="year">
        <option value="">All</option>
        {years.map((year) => <option value={year}>{year}</option>)}
      </select>
    </label>
    <label>
      Topic
      <select data-filter="topic">
        <option value="">All</option>
        {topics.map((topic) => <option value={topic}>{topic}</option>)}
      </select>
    </label>
    <label>
      Venue
      <select data-filter="venue">
        <option value="">All</option>
        {venues.map((venue) => <option value={venue}>{venue}</option>)}
      </select>
    </label>
    <label>
      Has
      <select data-filter="artifact">
        <option value="">Any</option>
        {artifacts.map((artifact) => <option value={artifact}>{capitalize(artifact)}</option>)}
      </select>
    </label>
  </div>

  <p class="status" aria-live="polite">
    <span>Showing <span data-result-count>{publications.length}</span> of {publications.length} publications.</span>
    <span class="legend">* equal contribution · † corresponding author · <span class="mentored-author">underline</span>: student mentored by the PI</span>
  </p>
  <p class="empty" data-empty hidden>No publications match these filters.</p>

  {years.map((year) => (
    <section class="year-group" data-year-group>
      <h2>{year}</h2>
      <ol class="pub-list">
        {publications.filter((paper) => paper.year === year).map((paper) => (
          <PublicationEntry
            paper={paper}
            data-publication
            data-year={paper.year}
            data-topics={[paper.primaryTopic, ...(paper.secondaryTopics ?? [])].join(" | ")}
            data-venue={paper.venueShort}
            data-artifacts={(paper.artifacts ?? []).join(" ")}
            data-search={`${paper.title} ${paper.authors} ${paper.venue} ${paper.abstract} ${(paper.tags ?? []).join(" ")}`.toLowerCase()}
          />
        ))}
      </ol>
    </section>
  ))}
</section>

<script>
  // @ts-nocheck
  const archive = document.querySelector("[data-publication-archive]");
  if (archive) {
    const controls = archive.querySelectorAll("[data-filter]");
    const count = archive.querySelector("[data-result-count]");
    const empty = archive.querySelector("[data-empty]");
    const papers = [...archive.querySelectorAll("[data-publication]")];
    const groups = [...archive.querySelectorAll("[data-year-group]")];
    const params = new URLSearchParams(window.location.search);

    const readFilters = () => Object.fromEntries([...controls].map((control) => [control.dataset.filter, control.value.toLowerCase()]));

    const applyFilters = () => {
      const filters = readFilters();
      let visible = 0;
      for (const paper of papers) {
        const matchesSearch = !filters.search || paper.dataset.search.includes(filters.search);
        const matchesYear = !filters.year || paper.dataset.year === filters.year;
        const matchesTopic = !filters.topic || paper.dataset.topics.toLowerCase().includes(filters.topic);
        const matchesVenue = !filters.venue || paper.dataset.venue.toLowerCase() === filters.venue;
        const matchesArtifact = !filters.artifact || paper.dataset.artifacts.toLowerCase().split(" ").includes(filters.artifact);
        const show = matchesSearch && matchesYear && matchesTopic && matchesVenue && matchesArtifact;
        paper.hidden = !show;
        if (show) visible += 1;
      }
      for (const group of groups) {
        group.hidden = !group.querySelector("[data-publication]:not([hidden])");
      }
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible > 0;
    };

    controls.forEach((control) => control.addEventListener("input", applyFilters));
    controls.forEach((control) => {
      const value = params.get(control.dataset.filter);
      if (value) control.value = value;
    });
    applyFilters();
  }
</script>

<style>
  .archive {
    margin-top: 1.75rem;
  }

  .controls {
    display: grid;
    gap: 0.75rem 1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .search {
    grid-column: 1 / -1;
  }

  label {
    color: var(--muted);
    display: grid;
    font-size: 0.85rem;
    gap: 0.2rem;
  }

  input,
  select {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--text);
    font-size: 0.95rem;
    min-height: 2.25rem;
    min-width: 0;
    padding: 0.3rem 0.5rem;
  }

  .status {
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.88rem;
    gap: 0.25rem 1.5rem;
    justify-content: space-between;
    margin-top: 1rem;
    padding-bottom: 0.6rem;
  }

  .empty {
    color: var(--muted);
    margin-top: 1.5rem;
  }

  .year-group {
    margin-top: 1.75rem;
  }

  .year-group[hidden] {
    display: none;
  }

  .year-group h2 {
    color: var(--muted);
    font-size: 1.3rem;
  }

  @media (max-width: 640px) {
    .controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
