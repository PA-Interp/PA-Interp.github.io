---
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<header class="container page-head">
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding-top: 2.5rem;
  }

  .lead {
    margin-top: 0.6rem;
  }
</style>
