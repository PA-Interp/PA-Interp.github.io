---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PublicationArchive from "../components/PublicationArchive.astro";
import { site } from "../data/site.js";
import publications from "../data/publications.json";
---

<BaseLayout title="Publications" description="Publications from PAI Lab at MBZUAI, searchable by year, topic, and venue.">
  <PageHero title="Publications">
    <p class="lead">
      Papers by members of PAI Lab, newest first. The list is also maintained on
      <a href={site.piHomepage}>{site.piName}'s homepage</a>.
    </p>
  </PageHero>

  <div class="container">
    <PublicationArchive publications={publications} />
  </div>
</BaseLayout>

<style>
  .lead {
    margin-top: 0.6rem;
  }
</style>
