---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site.js";

const openProblems = [
  "What makes an interpretability method provable rather than only plausible?",
  "How can large-model explanations become actionable evidence for debugging and intervention?",
  "What systems make interpretability reproducible, comparable, and deployable?",
  "How can interactive explanations support decisions, control, and human-AI workflows?",
  "How can PAI methods support scientific hypothesis generation?"
];
---

<BaseLayout title="Join Us" description="Open positions at PAI Lab, MBZUAI: PhD students, postdocs, research assistants, and visiting students.">
  <PageHero title="Join Us" />

  <div class="container">
    <section class="section prose">
      <div class="section-head"><h2>Openings</h2></div>
      <ul>
        <li><strong>PhD students</strong>, starting Fall 2027.</li>
        <li><strong>Postdocs, research assistants, visiting PhD students, and collaborators</strong>, with a flexible timeline.</li>
      </ul>
      <p>
        We welcome students and collaborators with backgrounds in machine learning, theory, NLP, vision, HCI, systems,
        scientific AI, or evaluation.
      </p>
    </section>

    <section class="section prose">
      <div class="section-head"><h2>Open problems</h2></div>
      <p>Some of the questions we are currently working on:</p>
      <ul>
        {openProblems.map((problem) => <li>{problem}</li>)}
      </ul>
    </section>

    <section class="section prose">
      <div class="section-head"><h2>How to apply</h2></div>
      <p>
        Email your CV, academic transcript, and a brief research plan to
        <a href={`mailto:${site.contactEmail}?subject=PAI%20Lab%20Application`}>{site.contactEmail}</a>. Prior
        publications are not required for PhD applicants; long-term commitment to careful research matters.
      </p>
      <p>More about the PI: <a href={site.piHomepage}>{site.piName}</a>.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .prose {
    max-width: 70ch;
  }

  .prose ul {
    margin: 0.6rem 0 0.9rem;
  }
</style>
