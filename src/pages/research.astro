---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { projects } from "../data/projects.js";
import { researchAreas } from "../data/researchAreas.js";
import { withBase } from "../data/site.js";
import { papersForTopic } from "../lib/publications";
import publications from "../data/publications.json";

const areas = researchAreas.map((area) => {
  const papers = papersForTopic(publications, area.title);
  return {
    ...area,
    papers: papers.slice(0, 4),
    paperCount: papers.length,
    projects: projects.filter((project) => project.area === area.id),
    archiveHref: `${withBase("/publications/")}?topic=${encodeURIComponent(area.title)}`
  };
});
---

<BaseLayout title="Research" description="Research areas of PAI Lab at MBZUAI, with representative papers for each.">
  <PageHero
    title="Research"
    lead="Our work is organized into five areas, from theoretical foundations to applications in science. Each section below states the question we study, our approach, and representative papers."
  />

  <div class="container">
    <ul class="toc">
      {areas.map((area) => <li><a href={`#${area.id}`}>{area.title}</a></li>)}
    </ul>

    {areas.map((area) => (
      <section class="section area" id={area.id}>
        <div class="section-head"><h2>{area.title}</h2></div>
        <p class="question">{area.question}</p>
        <div class="prose">
          <p>{area.why}</p>
          <p>{area.approach}</p>
        </div>
        {area.projects.map((project) => (
          <p class="project">
            Project: <a href={withBase(project.href)}>{project.title}</a> ({project.subtitle})
          </p>
        ))}
        <h3>Representative papers</h3>
        <ol class="pub-list">
          {area.papers.map((paper) => <PublicationEntry paper={paper} />)}
        </ol>
        <p class="more"><a href={area.archiveHref}>All {area.paperCount} papers in this area →</a></p>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .toc {
    border-left: 2px solid var(--rule);
    list-style: none;
    margin-top: 1.5rem;
    padding: 0.1rem 0 0.1rem 1rem;
  }

  .toc li + li {
    margin-top: 0.15rem;
  }

  .question {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    margin-bottom: 0.75rem;
  }

  .prose {
    max-width: 70ch;
  }

  .project {
    margin-top: 0.9rem;
  }

  h3 {
    margin-top: 1.5rem;
  }

  .more {
    font-size: 0.94rem;
    margin-top: 0.4rem;
  }
</style>
