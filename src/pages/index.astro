---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsList from "../components/NewsList.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { researchAreas } from "../data/researchAreas.js";
import { site, withBase } from "../data/site.js";
import publications from "../data/publications.json";

const selectedPublications = publications
  .filter((paper) => paper.representative)
  .sort((a, b) => b.year - a.year);
---

<BaseLayout title={site.name} description={site.mission}>
  <div class="container">
    <section class="intro">
      <h1>{site.name}</h1>
      <p class="affiliation">{site.affiliation} · {site.location}</p>
      <div class="prose">
        <p>
          PAI Lab (Provable and Actionable Interpretability) is a research group in the Machine Learning Department at
          MBZUAI, led by <a href={site.piHomepage}>{site.piName}</a>. We study how to explain the behavior of machine
          learning models, especially large language and multimodal models, in ways that come with guarantees and that
          people can act on: auditing and steering models, editing and unlearning behavior, and supporting scientific
          discovery.
        </p>
        <p>We are recruiting PhD students for Fall 2027. See <a href={withBase("/join-us/")}>Join Us</a>.</p>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Research</h2>
        <a href={withBase("/research/")}>More on our research →</a>
      </div>
      <dl class="areas">
        {researchAreas.map((area) => (
          <div>
            <dt><a href={withBase(`/research/#${area.id}`)}>{area.title}</a></dt>
            <dd>{area.approach}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Selected Publications</h2>
        <a href={withBase("/publications/")}>All publications →</a>
      </div>
      <ol class="pub-list">
        {selectedPublications.map((paper) => <PublicationEntry paper={paper} />)}
      </ol>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>News</h2>
        <a href={withBase("/news/")}>All news →</a>
      </div>
      <NewsList limit={6} />
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    padding-top: 2.5rem;
  }

  .affiliation {
    color: var(--muted);
    margin: 0.2rem 0 1.25rem;
  }

  .prose {
    font-size: 1.06rem;
    max-width: 70ch;
  }

  .areas > div + div {
    margin-top: 0.9rem;
  }

  dt {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 600;
  }

  dd {
    color: var(--muted);
    max-width: 70ch;
  }
</style>
